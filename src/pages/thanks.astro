---
// Shown when the form is submitted without JavaScript.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import site from "../data";
---
<Base title={`Message sent | ${site.name}`} noindex>
  <Header />
  <main class="container py-32 text-center">
    <h1 class="text-4xl font-bold mb-4">Thanks, we got your message</h1>
    <p class="text-xl text-muted-foreground mb-8">We'll get back to you within 24 hours. Need us sooner? Call {site.phone}.</p>
    <a href="/" class="btn btn-lg bg-gradient-primary text-primary-foreground hover:opacity-90 shadow-tech">Back to home</a>
  </main>
  <Footer />
</Base>

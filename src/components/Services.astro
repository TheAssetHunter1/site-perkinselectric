---
import Icon from "./Icon.astro";
import site from "../data";
const emergencyTel = `tel:${site.phone.replace(/\D/g, "")}`;
---
<section id="services" class="py-20 bg-secondary/30">
  <div class="container">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-foreground mb-4">Electrical Services</h2>
      <p class="text-xl text-muted-foreground max-w-3xl mx-auto">
        From a single outlet to a full panel upgrade, Perkins Electric handles residential and commercial
        electrical work across Kerrville and the Hill Country.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {site.services.map((service) => (
        <article class="card group shadow-xs hover:shadow-card-tech transition-all duration-300 hover:-translate-y-1 bg-gradient-card">
          <div class="card-header text-center pb-4">
            <div class="mx-auto w-16 h-16 bg-primary/10 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary/20 transition-colors">
              <Icon name={service.icon} class="h-8 w-8 text-primary" />
            </div>
            <h3 class="card-title text-lg">{service.title}</h3>
            <p class="card-description">{service.description}</p>
          </div>
          <div class="card-content">
            <ul class="space-y-2">
              {service.features.map((feature) => (
                <li class="flex items-center text-sm text-muted-foreground">
                  <span class="w-1.5 h-1.5 bg-primary rounded-full mr-2 shrink-0"></span>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="text-center">
      <div class="card inline-block p-8 bg-gradient-primary shadow-tech text-left">
        <div class="flex flex-col sm:flex-row items-center gap-4 text-primary-foreground">
          <Icon name="zap" class="h-8 w-8 shrink-0 text-accent" />
          <div class="text-center sm:text-left">
            <h3 class="text-xl font-semibold">Power out or breaker won't reset?</h3>
            <p class="text-primary-foreground/90">Call now. Same-day service when the schedule allows.</p>
          </div>
          <a href={emergencyTel} class="btn btn-lg sm:ml-4 bg-accent-glow text-accent-foreground font-semibold hover:opacity-90">Call Now</a>
        </div>
      </div>
    </div>
  </div>
</section>
